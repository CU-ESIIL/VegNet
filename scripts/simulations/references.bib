  number  = {7},
  pages   = {278--285},
  doi     = {10.1016/S0169-5347(00)01874-7}
}

% Fitted seed dispersal kernels; most seeds fall near the parent, with a
% long tail. Same use as nathan2000dispersal.
@article{clark1999dispersal,
  author  = {Clark, James S. and Silman, Miles and Kern, Ruth and Macklin, Eric and HilleRisLambers, Janneke},
  title   = {Seed Dispersal Near and Far: Patterns Across Temperate and Tropical Forests},
  journal = {Ecology},
