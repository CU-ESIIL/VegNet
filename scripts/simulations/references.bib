  number  = {6},
  pages   = {1299--1307},
  doi     = {10.1111/j.1365-2745.2011.01867.x}
}

% Clonal (lateral) spread is common in perennial herbs of temperate floras;
% the source of clumped, slow-spreading perennials represented by high
% disp_rate at low z.
@article{klimesova2009clopla,
  author  = {Klime{\v{s}}ov{\'a}, Jitka and de Bello, Francesco},
