% =====================================================================
% 4. Dispersal and clumping (disp_rate in life_history_params(),
%    seed_rain_array_fast(), clumping index in landscape_diagnostics())
% =====================================================================

% Short dispersal produces intraspecific clumping. Clumped species compete
% mostly with conspecifics, which is stabilizing. Short dispersal also has a
% cost: many seeds land near the parent in already occupied sites. This cost
% is why life_history_params() divides lambda_max by 1 - P(d = 0), so that
% the equalizing trade-off applies to seeds that actually leave the parent
% cell.
@article{bolker1999spatial,
  author  = {Bolker, Benjamin M. and Pacala, Stephen W.},
  title   = {Spatial Moment Equations for Plant Competition: Understanding Spatial Strategies and the Advantages of Short Dispersal},
  journal = {The American Naturalist},
  year    = {1999},
  volume  = {153},
  number  = {6},
  pages   = {575--602},
  doi     = {10.1086/303199}
}

% Experimental evidence that intraspecific aggregation changes competitive
% outcomes and can let weaker competitors persist. Supports clumped
% perennials as a coexistence-promoting spatial structure.
@article{stoll2001aggregation,
  author  = {Stoll, Peter and Prati, Daniel},
  title   = {Intraspecific aggregation alters competitive interactions in experimental plant communities},
  journal = {Ecology},
  year    = {2001},
  volume  = {82},
  number  = {2},
  pages   = {319--327},
  doi     = {10.1890/0012-9658(2001)082[0319:IAACII]2.0.CO;2}
}

% Seed shadows are leptokurtic and decline steeply with distance from the
