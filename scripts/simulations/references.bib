% =====================================================================
% 3. Fecundity-survival trade-off (lambda_max and Pr_death in
%    life_history_params())
% =====================================================================

% Species with high annual seed output are shorter-lived, so seed output
% per lifetime is roughly similar across species. This is the empirical
% basis for lambda_max = f0 * Pr_death (annual output proportional to death
% rate, so lifetime output, lambda / delta, is roughly constant along z).
@article{moles2004seeds,
  author  = {Moles, Angela T. and Falster, Daniel S. and Leishman, Michelle R. and Westoby, Mark},
  title   = {Small-seeded species produce more seeds per square metre of canopy per year, but not per individual per lifetime},
  journal = {Journal of Ecology},
  year    = {2004},
  volume  = {92},
  number  = {3},
  pages   = {384--396},
  doi     = {10.1111/j.0022-0477.2004.00880.x}
}

% Seed size / seed number trade-offs across the whole life cycle; supports
% annuals (high z) producing many small propagules and perennials few.
@article{moles2006seedsize,
  author  = {Moles, Angela T. and Westoby, Mark},
  title   = {Seed size and plant strategy across the whole life cycle},
  journal = {Oikos},
  year    = {2006},
  volume  = {113},
  number  = {1},
  pages   = {91--105},
  doi     = {10.1111/j.0030-1299.2006.14194.x}
}

% Seed vs. microsite limitation of recruitment. Annuals regenerate only from
