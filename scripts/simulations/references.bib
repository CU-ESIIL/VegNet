% References for the biological choices in the lottery-model simulations
%   scripts/simulations/lottery_param_functions.R
%   scripts/simulations/terrestrial_lottery_sim_functions.R
%   scripts/simulations/lottery_model_sims.R
%
% Comments above each entry say which simulation choice it supports.
% Metadata and DOIs were checked against Crossref (2026-10-30).
%
% NOTE: the specific default values (p_death = c(0.03, 1), f0 = 150,
% disp_rate = c(2, 0.2), sigma_env_sens = c(10, 40), rho_max = 0.5,
% overlap_width = 0.3, hierarchy = 1, m = 0.01, the z^2 death curve) are
% tuning choices made to get many coexisting species in a 60 x 60 lattice.
% The literature below supports the direction and form of each choice, not
% these exact numbers.


% =====================================================================
% 1. The lottery model and its stationary state
% =====================================================================

% Origin of the lottery idea: open sites (here, cells vacated by death in
% die_replace()) are won at random in proportion to propagule arrival
% (seed_rain), so many species can share space.
@article{sale1977,
  author  = {Sale, Peter F.},
  title   = {Maintenance of High Diversity in Coral Reef Fish Communities},
  journal = {The American Naturalist},
  year    = {1977},
  volume  = {111},
  number  = {978},
  pages   = {337--359},
  doi     = {10.1086/283164}
}

% The lottery model: adults die with probability delta_i (Pr_death) and
% vacant sites go to species in proportion to their propagule output.
% - In a constant environment the recursion gives the invasion criterion
%   lambda_i / delta_i > lambda_r / delta_r, which is the basis for tying
%   lambda_max to Pr_death in life_history_params() (equalizing trade-off).
% - With fluctuating recruitment (env[t] and the species-specific optima) and
%   overlapping generations (Pr_death < 1), species coexist through the
%   storage effect. This is the stationary state the burn-in in
%   lottery_model_sims.R is meant to reach.
@article{chesson1981lottery,
  author  = {Chesson, Peter L. and Warner, Robert R.},
  title   = {Environmental Variability Promotes Coexistence in Lottery Competitive Systems},
  journal = {The American Naturalist},
  year    = {1981},
  volume  = {117},
  number  = {6},
  pages   = {923--943},
  doi     = {10.1086/283778}
}

% Storage effect requirements, mapped onto the simulation:
% (i) species-specific responses to the environment (optims, sigma);
% (ii) covariance between environment and competition (good years raise
%     seed rain of the favored species);
% (iii) buffered population growth, i.e. long-lived adults (low Pr_death
%     at low z). Strict annuals (Pr_death = 1, no seed bank in this model)
%     get no buffering and so gain little from the storage effect; they
%     persist mainly through high fecundity, dispersal, and immigration.
@article{warner1985storage,
  author  = {Warner, Robert R. and Chesson, Peter L.},
  title   = {Coexistence Mediated by Recruitment Fluctuations: A Field Guide to the Storage Effect},
  journal = {The American Naturalist},
  year    = {1985},
  volume  = {125},
  number  = {6},
  pages   = {769--787},
  doi     = {10.1086/284379}
}

% Multispecies generalization of the lottery/storage-effect framework. Supports
% using one shared temporal environment (env[t]) with species-specific
% responses to maintain many (nsp = 15) rather than two species.
@article{chesson1994multispecies,
  author  = {Chesson, P.},
  title   = {Multispecies Competition in Variable Environments},
  journal = {Theoretical Population Biology},
  year    = {1994},
  volume  = {45},
  number  = {3},
  pages   = {227--276},
  doi     = {10.1006/tpbi.1994.1013}
}

% Stabilizing vs. equalizing mechanisms. The parameterization strategy is
% (a) equalize: fecundity proportional to death rate, with small fitness_sd
%     noise, keeps fitness ratios near 1 across the life-history axis;
% (b) stabilize: intra > inter competition (diag of comp_matrix_gradient()),
%     the storage effect, and crowding within clumps.
@article{chesson2000mechanisms,
  author  = {Chesson, Peter},
  title   = {Mechanisms of Maintenance of Species Diversity},
  journal = {Annual Review of Ecology and Systematics},
  year    = {2000},
  volume  = {31},
  number  = {1},
  pages   = {343--366},
  doi     = {10.1146/annurev.ecolsys.31.1.343}
}

% Coexistence requires niche differences to overcome fitness differences;
% small fitness differences (fitness_sd) need only weak stabilization.
@article{adler2007niche,
  author  = {Adler, Peter B. and HilleRisLambers, Janneke and Levine, Jonathan M.},
  title   = {A niche for neutrality},
  journal = {Ecology Letters},
  year    = {2007},
  volume  = {10},
  number  = {2},
  pages   = {95--104},
  doi     = {10.1111/j.1461-0248.2006.00996.x}
}

% Review of plant coexistence mechanisms; general support for combining
% several weak stabilizing mechanisms in a plant community model.
@article{silvertown2004niche,
  author  = {Silvertown, Jonathan},
  title   = {Plant coexistence and the niche},
  journal = {Trends in Ecology \& Evolution},
  year    = {2004},
  volume  = {19},
  number  = {11},
  pages   = {605--611},
  doi     = {10.1016/j.tree.2004.09.003}
}

% Discrete, spatially explicit (lattice) versions of competition models can
% behave very differently from mean-field ones. This is why the stationary
% state is checked by simulation (landscape_diagnostics()) rather than taken
% from the non-spatial lottery result.
@article{durrett1994discrete,
  author  = {Durrett, R. and Levin, S.},
  title   = {The Importance of Being Discrete (and Spatial)},
  journal = {Theoretical Population Biology},
  year    = {1994},
  volume  = {46},
  number  = {3},
  pages   = {363--394},
  doi     = {10.1006/tpbi.1994.1032}
}

% Recruitment limitation: when not every vacant site gets seeds of every
% species (short dispersal), competitive exclusion slows dramatically and
% inferior competitors persist. Relevant to the long-transient /
% burn-in question: perennials with Pr_death ~ 0.03 have mean lifespans of
% ~33 steps, so burn_in = 100 is only ~3 generations for them, and their
% cover can still drift slowly after burn-in.
@article{hurtt1995recruitment,
  author  = {Hurtt, George C. and Pacala, Stephen W.},
  title   = {The consequences of recruitment limitation: reconciling chance, history and competitive differences between plants},
  journal = {Journal of Theoretical Biology},
  year    = {1995},
  volume  = {176},
  number  = {1},
  pages   = {1--12},
  doi     = {10.1006/jtbi.1995.0170}
}


